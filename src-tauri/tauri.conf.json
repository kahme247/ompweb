{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ompweb",
  "version": "0.1.0",
  "identifier": "com.kahme247.ompweb",
  "build": {
    "beforeDevCommand": "npm run desktop-ui:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run desktop-ui:build",
    "frontendDist": "../desktop-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "omp-web",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Khaled Ahmed",
    "copyright": "© 2026 Khaled Ahmed",
    "shortDescription": "Native desktop companion for the oh-my-pi agent",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

    <string name="app_name">ompweb</string>

    <string name="connect_heading">Connect to your server</string>
    <string name="connect_intro">Enter the address of your ompweb server. You can find it in ompweb under Settings → Mobile app.</string>
    <string name="connect_address_label">Server address</string>
    <string name="connect_address_placeholder">100.64.0.10 or my-pc.tailnet.ts.net</string>
    <string name="connect_button">Connect</string>
    <string name="connect_checking">Checking server…</string>
    <string name="connect_resolved">Requests go to %1$s</string>
    <string name="connect_help">Over Tailscale this is usually a 100.x address or a …ts.net name. A home-network address only works while your phone is on that network.</string>

    <string name="probe_misconfigured_title">Server misconfigured</string>
    <string name="probe_misconfigured_message">ompweb is running, but its password is not configured correctly on the PC. Set OMP_WEB_PASSWORD_HASH and restart the server.</string>
    <string name="probe_forbidden_title">Request blocked</string>
    <string name="probe_forbidden_message">The server refused the request. A proxy in front of ompweb may be blocking native clients.</string>
    <string name="probe_not_ompweb_title">Not an ompweb server</string>
    <string name="probe_not_ompweb_message">Something answered, but it does not look like ompweb. Check the address and the port.</string>
    <string name="probe_unreachable_title">Cannot reach the server</string>
    <string name="probe_unreachable_message">Is Tailscale connected and is ompweb shared on the network? Check that the address and port are right.</string>
    <string name="probe_tls_title">Secure connection failed</string>
    <string name="probe_tls_message">The server certificate could not be verified. Check that the address matches the certificate. Plain HTTP is only accepted for an address that resolves into your own private network.</string>


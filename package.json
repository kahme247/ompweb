{
  "name": "@kahme247/ompweb",
  "version": "0.6.0",
  "description": "Web UI for the oh-my-pi (omp) coding agent",
  "homepage": "https://github.com/kahme247/ompweb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahme247/ompweb.git"
  },
  "bugs": {
    "url": "https://github.com/kahme247/ompweb/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "ompweb": "bin/omp-web.js",
    "ompweb-tray": "bin/omp-web-tray.js",
    "ompweb-tray-linux": "bin/linux-tray.js",
    "ompweb-launchd": "bin/omp-web-launchd.js",
    "ompweb-systemd": "bin/omp-web-systemd.js"
  },
  "files": [
    "bin",
    "lib",
    "app/api",
    "app/fonts/*-OFL.txt",
    "app/fonts/*-LICENSE.*",
    "server",
    "dist",
    "public",
    "scripts",
    "proxy.ts",
    "instrumentation.node.ts",
    "tsconfig.json",
    "package.json"
  ],
  "scripts": {
    "dev": "bun --hot server/dev.ts -H 127.0.0.1 -p 30178",
    "dev:lan": "bun --hot server/dev.ts -H 0.0.0.0 -p 30178",
    "build": "bun scripts/build-client.ts",
    "build:binary": "npm run build && bun scripts/build-binary.ts",
    "start": "bun server/main.ts -H 127.0.0.1 -p 30177",
    "start:lan": "bun server/main.ts -H 0.0.0.0 -p 30177",
    "test": "bun test --parallel --timeout 30000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tray:install": "node bin/omp-web-tray.js --install",
    "tray:uninstall": "node bin/omp-web-tray.js --uninstall",
    "tray:start": "node bin/omp-web-tray.js --start",
    "tray:status": "node bin/omp-web-tray.js --status",
    "systemd:install": "node bin/omp-web-systemd.js install",
    "systemd:uninstall": "node bin/omp-web-systemd.js uninstall",
    "systemd:start": "node bin/omp-web-systemd.js start",
    "systemd:stop": "node bin/omp-web-systemd.js stop",
    "systemd:status": "node bin/omp-web-systemd.js status",
    "prepack": "npm run build",
    "smoke": "bun scripts/smoke.ts",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "bun": "1.4.4",
    "cmdk": "^1.1.1",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.39.0",
    "mammoth": "^1.12.2",
    "mdast-util-find-and-replace": "^3.0.2",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "web-push": "^3.6.7",
    "yaml": "^2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "1.4.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/web-push": "^3.6.4",
    "bun-plugin-tailwind": "0.1.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "typescript-language-server": "^6.0.0"
  }
}
